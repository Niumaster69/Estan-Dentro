  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EstanDentro.Interaction.EndGameTrigger
  slides:
  - text: "Diecisiete de mayo. Tu cumplea\xF1os."
    durationSeconds: 3.5
    audio: {fileID: 0}
  - text: "Ese d\xEDa no muri\xF3 nadie."
    durationSeconds: 3.5
    audio: {fileID: 0}
  - text: "Pa est\xE1 vivo. Te visita todos los d\xEDas."
    durationSeconds: 4
    audio: {fileID: 0}
  - text: "El que no ha vuelto eres t\xFA."
    durationSeconds: 4
    audio: {fileID: 0}
  - text: "Tres a\xF1os dormido."
    durationSeconds: 3.5
    audio: {fileID: 0}
  - text: "Respira conmigo, mijo. Cuatro\u2026 sost\xE9n\u2026 seis."
    durationSeconds: 5
    audio: {fileID: 0}
  - text: Algo no quiere que despiertes.
    durationSeconds: 4
    audio: {fileID: 0}
  fadeToBlackDuration: 1.5
  slideFadeIn: 0.8
  slideFadeOut: 0.8
  beforeReturnToMenuDelay: 2
  slideFontSize: 44
  slideTextColor: {r: 0.92, g: 0.89, b: 0.83, a: 1}
