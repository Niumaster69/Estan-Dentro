  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EstanDentro.Interaction.Note
  noteTitle: Una foto
  noteText: "Una foto vieja, doblada en una esquina.\n\nPa con una guitarra prestada
    y yo, de nueve a\xF1os, tap\xE1ndome la cara.\nAtr\xE1s, a l\xE1piz: \xABD\xEDa
    de la familia \u2014 Aula de m\xFAsica\xBB.\n\n\u2026\xBFPor qu\xE9 est\xE1 esto
    aqu\xED?"
  disappearAfterRead: 1
  pickupClip: {fileID: 0}
  pickupVolume: 0.85
